{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1400px",
      "wideSize": "1400px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "bg",         "color": "#0F1116", "name": "Background" },
        { "slug": "bg2",        "color": "#181B22", "name": "Surface" },
        { "slug": "fg",         "color": "#ECE6D8", "name": "Foreground" },
        { "slug": "mute",       "color": "#898577", "name": "Muted" },
        { "slug": "acc",        "color": "#C9A35E", "name": "Accent" },
        { "slug": "acc-deep",   "color": "#8E7038", "name": "Accent Deep" },
        { "slug": "secondary",  "color": "#5A2A2A", "name": "Secondary" },
        { "slug": "w-bg",       "color": "#FBFAF7", "name": "Women Background" },
        { "slug": "w-fg",       "color": "#1F1D1A", "name": "Women Foreground" },
        { "slug": "w-acc",      "color": "#533673", "name": "Women Accent" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        { "slug": "display", "name": "Display", "fontFamily": "\"Fraunces\", \"Cormorant Garamond\", Georgia, serif" },
        { "slug": "sans",    "name": "Sans",    "fontFamily": "\"Inter Tight\", system-ui, sans-serif" },
        { "slug": "mono",    "name": "Mono",    "fontFamily": "\"JetBrains Mono\", \"IBM Plex Mono\", \"SF Mono\", ui-monospace, monospace" }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "13px",                                       "name": "Small" },
        { "slug": "medium",  "size": "16px",                                       "name": "Medium" },
        { "slug": "large",   "size": "clamp(28px, 3vw, 44px)",                     "name": "Large" },
        { "slug": "x-large", "size": "clamp(44px, 6vw, 96px)",                     "name": "X-Large" },
        { "slug": "hero",    "size": "clamp(56px, 8vw, 132px)",                    "name": "Hero" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw"],
      "spacingScale": { "operator": "*", "increment": 1, "steps": 0 },
      "spacingSizes": [
        { "slug": "xs",  "size": "8px",   "name": "XS" },
        { "slug": "sm",  "size": "16px",  "name": "SM" },
        { "slug": "md",  "size": "24px",  "name": "MD" },
        { "slug": "lg",  "size": "48px",  "name": "LG" },
        { "slug": "xl",  "size": "96px",  "name": "XL" },
        { "slug": "2xl", "size": "128px", "name": "2XL" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--fg)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "0.96", "fontSize": "var(--wp--preset--font-size--hero)" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.02", "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": { "color": { "text": "var(--wp--preset--color--fg)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" }
  ]
}
